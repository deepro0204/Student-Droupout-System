# Copy to `.env` and fill in as needed. All values have safe dev defaults.

# --- General ---
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth / JWT ---
# Generate a strong value for production, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEMO_PASSWORD=password

# --- Gemini (leave blank to use the deterministic fallback insights) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Email / SMTP (leave SMTP_HOST blank to run emails in dry-run mode) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=noreply@caresphere.edu
FROM_NAME=CareSphere Student Support
